<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Phê La | Thanh toán thành công</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
            rel="stylesheet"
        />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-slider@11.0.2/dist/css/bootstrap-slider.min.css"
        />
        <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="/client/css/style.css" />
        <link rel="stylesheet" href="/client/css/menu/menu.css" />
        <link rel="stylesheet" href="/client/css/cart/cart-popup.css" />
        <!-- Font-->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
            rel="stylesheet"
        />
        <link
            rel="shortcut icon"
            href="/images/favicon/favicon.ico"
            type="image/x-icon"
        />

        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <script
            src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.8.5/dist/dotlottie-wc.js"
            type="module"
        ></script>
        <style>
            .body {
                min-height: 90vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            }

            .success-container {
                background: white;
                border-radius: 20px;

                padding: 10px 40px;
                text-align: center;
                max-width: 700px;
                width: 100%;
                animation: slideUp 0.6s ease-out;
            }

            @keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .success-icon {
                width: 100px;
                height: 100px;

                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto;
                animation: scaleIn 0.6s ease-out;
            }

            @keyframes scaleIn {
                from {
                    transform: scale(0);
                }
                to {
                    transform: scale(1);
                }
            }

            .success-icon svg {
                width: 60px;
                height: 60px;
                color: white;
            }

            .success-title {
                font-size: 32px;
                font-weight: 700;
                color: #2d3748;
                margin-bottom: 15px;
            }

            .success-subtitle {
                font-size: 16px;
                color: #718096;
                margin-bottom: 10px;
            }

            .order-id {
                background: #f7fafc;
                border-left: #714024;
                padding: 15px 20px;
                border-radius: 8px;
                margin: 30px 0;
                text-align: left;
            }

            .order-id-label {
                font-size: 12px;
                color: #a0aec0;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .order-id-value {
                font-size: 18px;
                font-weight: 700;
                color: #2d3748;
                margin-top: 5px;
            }

            .order-details {
                background: #f7fafc;
                border-radius: 12px;
                padding: 20px;
                margin: 30px 0 15px;
                text-align: left;
            }

            .detail-row {
                display: flex;
                justify-content: space-between;
                padding: 10px 0;
                border-bottom: 1px solid #e2e8f0;
            }

            .detail-row:last-child {
                border-bottom: none;
            }

            .detail-label {
                color: #718096;
                font-size: 14px;
            }

            .detail-value {
                color: #2d3748;
                font-weight: 600;
            }

            .home-btn {
                background: #714024;
                color: white;
                border: none;
                padding: 15px 40px;
                font-size: 16px;
                font-weight: 600;
                border-radius: 50px;
                cursor: pointer;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                margin-top: 20px;
                width: 100%;
                text-decoration: none;
                display: inline-block;
            }

            .home-btn:hover {
                transform: translateY(-2px);
                box-shadow: #71402460;
                color: white;
            }

            @media (max-width: 576px) {
                .success-container {
                    padding: 40px 25px;
                }

                .success-title {
                    font-size: 24px;
                }
            }
        </style>
    </head>
    <body>
        <% if (!user) { %> <%- include('../layout/navbar.ejs'); -%> <% } else {
        %> <%- include('../layout/navbar_login.ejs'); -%><% } %>
        <div class="body">
            <div class="success-container">
                <!-- Success Icon -->

                <dotlottie-wc
                    src="https://lottie.host/a0070cc3-c965-4f73-ac8c-52455ea8087c/z0U7q87mOe.lottie"
                    class="success-icon"
                    style="width: 180px; height: 180px"
                    autoplay
                    loop
                ></dotlottie-wc>

                <!-- Title and Message -->
                <h1 class="success-title">Thanh Toán Thành Công!</h1>
                <p class="success-subtitle">
                    Cảm ơn bạn đã đặt hàng. Đơn hàng của bạn đã được xác nhận.
                </p>

                <!-- Order ID -->
                <div class="order-id">
                    <div class="order-id-label">Mã Đơn Hàng</div>
                    <div class="order-id-value"><%= order.order_id%></div>
                </div>

                <!-- Order Details -->
                <div class="order-details">
                    <div class="detail-row">
                        <span class="detail-label">Tổng Tiền</span>
                        <span class="detail-value">
                            <%= new Intl.NumberFormat('vi-VN', { style:
                            'currency', currency: 'VND'
                            }).format(order.final_amount) %></span
                        >
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Thời gian</span>
                        <span class="detail-value">
                            <%= new
                            Date(order.orderDate).toLocaleString('vi-VN', {
                            year: 'numeric', month: '2-digit', day: '2-digit',
                            hour: '2-digit', minute: '2-digit', second:
                            '2-digit', hour12: false })%></span
                        >
                    </div>
                </div>
                <!-- Home Button -->
                <a href="/" class="home-btn">Quay về trang chủ</a>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Xóa voucher đã chọn khi load trang
            window.addEventListener("DOMContentLoaded", () => {
                localStorage.removeItem("selectedVoucher");
                console.log("Voucher đã xóa khỏi localStorage");
            });
        </script>
    </body>
</html>
