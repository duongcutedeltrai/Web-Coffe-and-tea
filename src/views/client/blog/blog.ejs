<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Phê La | Tin tức</title>
        <link rel="stylesheet" href="styles.css" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
            rel="stylesheet"
        />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
            rel="stylesheet"
        /> 
       <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-slider@11.0.2/dist/css/bootstrap-slider.min.css"
        />
        <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="/client/css/style.css" />
        <link rel="stylesheet" href="/client/css/blog/blog.css" />
        <link rel="stylesheet" href="/client/css/cart/cart-popup.css" /> 
        <!-- Font-->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
            rel="stylesheet"
        />
        <link
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
  rel="stylesheet"
/>
        <link
            rel="shortcut icon"
            href="/images/favicon/favicon.ico"
            type="image/x-icon"
        />

        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <style>

        </style>
    </head>
    <body>
        <% if (!user) { %> <%- include('../layout/navbar.ejs'); -%> <% } else {
        %> <%- include('../layout/navbar_login.ejs'); -%><% } %><%-
        include('../cart/cart-popup.ejs'); -%>
    
        <main class="main-content">
    <div class="container">
      <!-- Hero Image -->
      <div class="hero-image">
        <img 
          src="<%= blog.thumbnail %>"
          alt="<%= blog.title %>"
        >
      </div>

      <!-- Title -->
      <h1 class="article-title"><%= blog.title %></h1>

      <!-- Post Metadata -->
      <div class="post-metadata">
        <div class="metadata-item">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#78350f" stroke-width="3">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <path d="M16 2v4M8 2v4M3 10h18"></path>
          </svg>
          <%= new Date(blog.created_at).toLocaleDateString('vi-VN', {
        weekday: 'long', year: 'numeric', month: 'short', day: 'numeric'
      }) %>
        </div>
        <div class="metadata-item">
          <i class="fa-solid fa-eye"style="color: #78350f;"></i>
          </svg>
          <span><%= blog.view_count || 0 %> views</span>
        </div>

        <!-- Social Share Icons -->
        <div class="social-share">
          <button class="social-btn" aria-label="Share on Facebook">
            <i class="fa-brands fa-facebook" style="color: #78350f;"></i>
          </button>
         
          <button class="social-btn" aria-label="Share on Twitter">
            <i class="fa-brands fa-x-twitter" style="color: #78350f;"></i>
          </button>
          <button class="social-btn" aria-label="Share via WhatsApp">
            <i class="fa-brands fa-square-whatsapp" style="color: #78350f;"></i>
          </button>
        </div>
      </div>

      <!-- Excerpt -->
      <div class="excerpt" >
        <%= blog.description %>
      </div>

      <!-- Article Content -->
      <article class="article-content" style="color: #4b2007;">
   <%- blog.content %>
      </article>

      <!-- Bottom CTA -->
     

      <!-- Navigation Buttons -->
      <div class="nav-buttons">
       <% if(prevBlog){ %>
    <a href="/blogs/<%= prevBlog.blog_id %>" class="nav-button nav-button-outline">← <%= prevBlog.title %></a>
  <% } %>
  <% if(nextBlog){ %>
    <a href="/blogs/<%= nextBlog.blog_id %>" class="nav-button nav-button-primary"><%= nextBlog.title %> →</a>
  <% } %>
      </div>
    </div>
  </main>
   <%- include('../layout/footer.ejs'); -%>
        <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap-slider@11.0.2/dist/bootstrap-slider.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/client/js/cart/cart-popup.js"></script>
        <script src="/client/js/blog/blog.js"></script>
        <script src="/client/js/favorite/favorites.js"></script>
    </body>
</html>
